{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/health", "destination": "/api/health" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }]
}
